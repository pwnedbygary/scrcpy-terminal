<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="accent">#FF4FC3F7</color>
    <color name="surface">#FF121417</color>
    <color name="card">#FF1D2126</color>
    <color name="muted">#FF9AA4AE</color>
    <color name="launcher_background">#FF101418</color>

    <style name="Theme.ScTerm" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.ScTerm.Viewer" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

</resources>
