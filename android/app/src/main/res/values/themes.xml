<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="accent">#FF4FC3F7</color>
    <color name="on_accent">#FF121417</color>
    <color name="surface">#FF121417</color>
    <color name="card">#FF1D2126</color>
    <color name="card_stroke">#FF2F353C</color>
    <color name="muted">#FF9AA4AE</color>
    <color name="launcher_background">#FF101418</color>

    <style name="Theme.ScTerm" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.ScTerm.Viewer" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- The viewer's floating controls (ControlsPanel): an undimmed window
         whose frosted background is set in code. Android only blurs behind
         translucent windows. -->
    <style name="Theme.ScTerm.ControlsPanel" parent="android:Theme.Material.Dialog.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowCloseOnTouchOutside">false</item>
        <item name="android:windowAnimationStyle">@style/ControlsPanelAnimation</item>
    </style>

    <style name="ControlsPanelAnimation">
        <item name="android:windowEnterAnimation">@anim/controls_in</item>
        <item name="android:windowExitAnimation">@anim/controls_out</item>
    </style>

    <!-- The app's own buttons (MainActivity, the viewer's connection overlay):
         the main action filled with the accent, the others outlined. No state
         list animator: a raised button's shadow would show around an outline. -->
    <style name="Widget.ScTerm.Button" parent="android:Widget.Material.Button">
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.ScTerm.Button.Primary">
        <item name="android:background">@drawable/button_primary</item>
        <item name="android:textColor">@color/button_primary_text</item>
    </style>

    <style name="Widget.ScTerm.Button.Secondary">
        <item name="android:background">@drawable/button_secondary</item>
        <item name="android:textColor">@color/button_secondary_text</item>
    </style>

</resources>
