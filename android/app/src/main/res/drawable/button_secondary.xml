<?xml version="1.0" encoding="utf-8"?>
<!-- Widget.ScTerm.Button.Secondary: a 40dp outlined button, inset in the 48dp
     touch target. The mask keeps the ripple inside the outline: the button
     itself is transparent there. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetTop="4dp"
    android:insetBottom="4dp">
    <ripple android:color="#334FC3F7">
        <item android:id="@android:id/mask">
            <shape android:shape="rectangle">
                <corners android:radius="10dp" />
                <solid android:color="@android:color/white" />
            </shape>
        </item>
        <item>
            <shape android:shape="rectangle">
                <corners android:radius="10dp" />
                <stroke
                    android:width="1dp"
                    android:color="@color/button_secondary_outline" />
                <padding
                    android:left="16dp"
                    android:right="16dp" />
            </shape>
        </item>
    </ripple>
</inset>
