<?xml version="1.0" encoding="utf-8"?>
<!-- A 40dp pill inset in the bar button's 48dp touch target. Pressed, only the
     outline lights up: a fill of about 20% white or more would leave the white
     label under 4.5:1 over a white screen in the landscape panel
     (ControlsPanel), and a fainter one hardly differs from the resting fill. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetTop="4dp"
    android:insetBottom="4dp">
    <selector>
        <item android:state_pressed="true">
            <shape android:shape="rectangle">
                <corners android:radius="10dp" />
                <solid android:color="#26FFFFFF" />
                <stroke
                    android:width="1dp"
                    android:color="#80FFFFFF" />
            </shape>
        </item>
        <item>
            <shape android:shape="rectangle">
                <corners android:radius="10dp" />
                <solid android:color="#26FFFFFF" />
                <stroke
                    android:width="1dp"
                    android:color="#1FFFFFFF" />
            </shape>
        </item>
    </selector>
</inset>
