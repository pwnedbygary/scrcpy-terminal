<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the device: pairings are bound to this installation's
     Keystore identity, which cannot be backed up or transferred, so restoring
     the peer list elsewhere would only produce broken pairings. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
